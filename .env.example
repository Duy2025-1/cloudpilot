# ==========================================
# CLOUDPILOT - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudpilot
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudpilot?schema=public"

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Security & Encryption (AES-256-GCM requires a 32-byte hex key: 64 hex characters)
# Example generated with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Docker & Deployment Engine
DEPLOYMENT_WORKSPACE_DIR=./tmp/workspaces
DOCKER_NETWORK=cloudpilot-apps-net
APP_BASE_DOMAIN=localhost

# GitHub App / OAuth Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/github/callback
GITHUB_WEBHOOK_SECRET=cloudpilot_dev_webhook_secret_key_12345

