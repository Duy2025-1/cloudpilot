{
  "name": "cloudpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:infra": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @cloudpilot/database db:generate",
    "db:migrate": "pnpm --filter @cloudpilot/database db:migrate",
    "db:push": "pnpm --filter @cloudpilot/database db:push",
    "db:seed": "pnpm --filter @cloudpilot/database db:seed",
    "db:backup": "pnpm --filter @cloudpilot/database db:backup",
    "db:restore": "pnpm --filter @cloudpilot/database db:restore",
    "db:studio": "pnpm --filter @cloudpilot/database db:studio",
    "api:dev": "pnpm --filter @cloudpilot/api start:dev",
    "web:dev": "pnpm --filter @cloudpilot/web dev",
    "build:packages": "pnpm --filter @cloudpilot/shared build && pnpm --filter @cloudpilot/database build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "certs:generate": "tsx scripts/generate-staging-certs.ts",
    "staging:up": "docker compose -f docker/docker-compose.staging.yml up -d",
    "staging:down": "docker compose -f docker/docker-compose.staging.yml down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/selfsigned": "^2.1.0",
    "eslint": "^10.12.0",
    "prettier": "^3.5.3",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1"
  }
}
