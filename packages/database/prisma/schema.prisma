datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DEVELOPER
  VIEWER
}

enum OAuthProvider {
  GITHUB
  GITLAB
}

enum ProjectRole {
  OWNER
  MAINTAINER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  IDLE
  BUILDING
  RUNNING
  FAILED
  STOPPED
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  DEPLOYING
  HEALTH_CHECKING
  SUCCESS
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum DeploymentTrigger {
  MANUAL
  GITHUB_WEBHOOK
  ROLLBACK
}

enum ReleaseStatus {
  ACTIVE
  INACTIVE
  ROLLED_BACK
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum AuditAction {
  USER_LOGIN
  USER_REGISTER
  USER_LOGOUT
  OAUTH_CONNECT
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  MEMBER_ADD
  MEMBER_UPDATE
  MEMBER_REMOVE
  ENV_CREATE
  ENV_UPDATE
  ENV_DELETE
  DEPLOYMENT_TRIGGER
  DEPLOYMENT_CANCEL
  DEPLOYMENT_ROLLBACK
  RELEASE_ACTIVATE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  role         Role         @default(DEVELOPER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions         Session[]
  oauthAccounts    OAuthAccount[]
  ownedProjects    Project[]       @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  deployments      Deployment[]    @relation("UserDeployments")
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id // random cryptographic session token string
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             OAuthProvider
  providerAccountId    String
  accessTokenEncrypted String?
  refreshTokenEncrypted String?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Project {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  repositoryUrl String
  defaultBranch String         @default("main")
  rootDirectory String?
  buildCommand  String?
  startCommand  String?
  port          Int            @default(3000)
  memoryLimitMb Int            @default(512)
  cpuLimit      Float          @default(0.5)
  status        ProjectStatus  @default(IDLE)
  ownerId       String
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  members       ProjectMember[]
  environments  Environment[]
  deployments   Deployment[]
  releases      Release[]
  auditLogs     AuditLog[]

  @@index([ownerId])
  @@index([slug])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Environment {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String        // "Production", "Staging", "Preview"
  slug         String        // "production", "staging"
  isProduction Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  envVars      EnvironmentVariable[]
  deployments  Deployment[]
  releases     Release[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("environments")
}

model EnvironmentVariable {
  id             String      @id @default(cuid())
  environmentId  String
  environment    Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  key            String
  encryptedValue String
  iv             String
  authTag        String
  isSecret       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([environmentId, key])
  @@index([environmentId])
  @@map("environment_variables")
}

model Deployment {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  commitSha      String
  commitMessage  String?
  branch         String
  status         DeploymentStatus  @default(QUEUED)
  trigger        DeploymentTrigger @default(MANUAL)
  containerId    String?
  containerPort  Int?
  durationMs     Int?
  errorDetails   String?
  rollbackFromId String?
  triggeredById  String?
  triggeredBy    User?             @relation("UserDeployments", fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  logs           DeploymentLog[]
  releases       Release[]

  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@index([createdAt])
  @@map("deployments")
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  level        LogLevel   @default(INFO)
  step         String     // e.g. "CLONE", "BUILD", "DEPLOY", "HEALTHCHECK"
  message      String
  createdAt    DateTime   @default(now())

  @@index([deploymentId, createdAt])
  @@map("deployment_logs")
}

model Release {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId     String
  environment       Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deploymentId      String
  deployment        Deployment    @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  version           Int           // Sequential release number: 1, 2, 3...
  status            ReleaseStatus @default(ACTIVE)
  imageTag          String?
  activeContainerId String?
  activePort        Int?
  activatedAt       DateTime      @default(now())
  retiredAt         DateTime?

  @@unique([environmentId, version])
  @@index([projectId])
  @@index([environmentId, status])
  @@map("releases")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action    AuditAction
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
  @@map("audit_logs")
}
