# Multi-stage Dockerfile for CloudPilot Worker
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.6.0 --activate

WORKDIR /app

# Copy root workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY apps/worker/package.json ./apps/worker/

# Install workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy source trees
COPY packages/tsconfig ./packages/tsconfig
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY apps/worker ./apps/worker

# Build shared packages and Worker
RUN pnpm --filter @cloudpilot/database db:generate
RUN pnpm --filter @cloudpilot/shared build
RUN pnpm --filter @cloudpilot/database build
RUN pnpm --filter @cloudpilot/worker build

# Prune non-production dependencies
RUN pnpm prune --prod

# Production Runner
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Install dumb-init, Docker CLI and Git for worker engine operations
RUN apk add --no-cache dumb-init docker-cli git

# Create non-root user and add to docker group (gid 999 or root group for socket access)
RUN addgroup -S cloudpilot && adduser -S cloudpilot -G cloudpilot

# Copy workspace node_modules and built dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/worker ./apps/worker

# Worker needs permissions to communicate with mounted Docker socket
USER cloudpilot

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/worker/dist/index.js"]
