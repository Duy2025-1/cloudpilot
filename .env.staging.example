# ==============================================================================
# CloudPilot Staging Environment Configuration
# ==============================================================================

# Core System
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Staging PostgreSQL Database
POSTGRES_USER=cloudpilot_staging
POSTGRES_PASSWORD=staging_secure_password_123
POSTGRES_DB=cloudpilot_staging
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cloudpilot_staging:staging_secure_password_123@postgres:5432/cloudpilot_staging?schema=public

# Staging Redis Queue & Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Cryptography & Security Secrets
# 64-character hex string (32 bytes) for AES-256-GCM envelope encryption
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_COOKIE_SECRET=staging_cookie_signing_secret_9876543210123456789
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://cloudpilot.local,https://cloudpilot.local

# GitHub Integration (Staging OAuth App & Webhook)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://cloudpilot.local/api/v1/github/callback
GITHUB_WEBHOOK_SECRET=staging_webhook_secret_123456789

# Staging Reverse Proxy Ports
HTTP_PORT=80
HTTPS_PORT=443
